{
  "include": "servers.json",
  "name": "ai",
  "environments": {
    "product": {
      "local_root": "/replace-path-to-your-local-product-root",
      "remote_root": "/replace-path-to-your-remote-product-root"
    },
    "test": {
      "local_root": "/replace-path-to-your-local-test-root",
      "remote_root": "/replace-path-to-your-remote-test-root"
    },
    "debug": {
      "local_root": "/replace-path-to-your-local-test-root",
      "remote_root": "/replace-path-to-your-remote-debug-root",
      "components": ["autointegrate", "sm", "v8"]
    }
  },
  "components": {
    "website": {
      "files": [
        "*.html",
        "*.css",
        "*.js",
        "*.json",
        "*.jpg",
        "*.png",
        "*.svg",
        "*.txt",
        "*.glb",
        "*.kml",
        "*.kmz",
        "*.geojson",
        "*.sh",
        "FitsPy.py",
        "getdownloads.py",
        "DownloadFit-master.zip"
      ]
    },
    "autointegrate": {
      "files": [
        "autointegrate/autointegrate-sm.zip",
        "autointegrate/autointegrate-v8.zip",
        "autointegrate/index.html",
        "autointegrate/updates.xri"
      ]
    },
    "sm": {
      "files": ["autointegrate/autointegrate-sm.zip"]
    },
    "v8": {
      "files": ["autointegrate/autointegrate-v8.zip"]
    }
  },
  "pixinsight": {
    "template": "autointegrate/updates.xri.template",
    "xri": "autointegrate/updates.xri",
    "packages": {
      "sm": {
        "placeholder": "SM",
        "zip": "autointegrate/autointegrate-sm.zip",
        "version_source": "autointegrate/sm/src/scripts/AutoIntegrate/AutoIntegrateGlobal.js",
        "version_var": "autointegrate_version",
        "info_var": "autointegrate_info"
      },
      "v8": {
        "placeholder": "V8",
        "zip": "autointegrate/autointegrate-v8.zip",
        "version_source": "autointegrate/v8/src/scripts/AutoIntegrate/AutoIntegrateGlobal.js",
        "version_var": "autointegrate_version",
        "info_var": "autointegrate_info"
      }
    }
  }
}
